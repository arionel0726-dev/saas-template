# Скопируйте в .env.local и заполните реальными значениями.

# --- База данных ---
# Строка подключения Postgres (Supabase/Neon/Docker) — см. drizzle.config.ts, src/lib/db.ts
DATABASE_URL=postgres://user:password@localhost:5432/app

# --- Better Auth ---
# Публичный URL, на котором смонтирован better-auth (обычно = NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000
# Секрет для подписи/шифрования сессий и токенов. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Google OAuth (better-auth socialProviders.google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Приложение ---
# Публичный URL приложения (используется в auth-client, метаданных, письмах, CSP)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (транзакционные письма через email_outbox, см. src/lib/email.ts) ---
RESEND_API_KEY=
# Адрес отправителя, должен быть подтверждён в Resend
EMAIL_FROM="app <noreply@example.com>"

# --- Lemon Squeezy (оплата, см. src/app/api/billing/*, src/app/api/webhooks/lemonsqueezy) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
# Секрет для проверки подписи вебхука (Lemon Squeezy dashboard -> Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Cron (Vercel Cron -> src/app/api/cron/*) ---
# Общий секрет, которым Vercel Cron авторизуется в cron-роутах (заголовок Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Админка ---
# Email-адреса через запятую, которым разрешён доступ к /dashboard/errors
ADMIN_EMAILS=admin@example.com
